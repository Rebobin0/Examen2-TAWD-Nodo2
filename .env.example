PORT=3000

# Banco Central (Supabase > Project Settings > API). Usar la clave anon/publishable, NUNCA la service_role.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=

# API Key de esta sucursal (la genera el panel del Banco Central al crear la sucursal).
# Opcional: también se puede capturar desde la pantalla "Configuración" del sistema.
BANCO_API_KEY=

# Acceso de los ejecutivos de la sucursal
SUCURSAL_USUARIO=ejecutivo
SUCURSAL_PASSWORD=
# Texto largo y aleatorio para firmar la sesión: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Zona horaria usada para agrupar los reportes por día
ZONA_HORARIA=America/Mexico_City
